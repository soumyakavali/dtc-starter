{
  "name": "biotill-monorepo",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace=@dtc/storefront",
    "build": "npm run build --workspace=@dtc/storefront",
    "start": "npm run start --workspace=@dtc/storefront",
    "lint": "npm run lint --workspace=@dtc/storefront",
    "seed": "npm run seed --workspace=@dtc/backend",
    "backend:seed": "npm run seed --workspace=@dtc/backend",
    "backend:dev": "npm run dev --workspace=@dtc/backend",
    "test:unit": "npm run test:unit --workspace=@dtc/backend",
    "test:integration": "npm run test:integration:http --workspace=@dtc/backend && npm run test:integration:modules --workspace=@dtc/backend",
    "test:integration:http": "npm run test:integration:http --workspace=@dtc/backend",
    "test:integration:modules": "npm run test:integration:modules --workspace=@dtc/backend",
    "test:sale-order": "npm run test:sale-order --workspace=@dtc/backend",
    "turbo:dev": "turbo dev",
    "turbo:build": "turbo build"
  },
  "devDependencies": {
    "turbo": "^2.4.2"
  },
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "npm@10.8.2"
}
